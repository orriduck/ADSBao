{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adsbao-frontend",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "adsbao.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.adsbao.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/events",
      "/events/*",
      "/health",
      "/runtime-env.js",
      "/ws"
    ]
  },
  "services": [
    {
      "binding": "ADSBAO_BACKEND",
      "service": "adsbao-backend"
    }
  ],
  "env": {
    "preview": {
      "routes": [],
      "services": [
        {
          "binding": "ADSBAO_BACKEND",
          "service": "adsbao-backend-preview",
          "remote": true
        }
      ],
      "secrets": {
        "required": [
          "VITE_NEW_RELIC_ACCOUNT_ID",
          "VITE_NEW_RELIC_BROWSER_APP_ID",
          "VITE_NEW_RELIC_BROWSER_LICENSE_KEY"
        ]
      }
    }
  }
}
