server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Railway's private-service address can change during a rolling deployment.
  # Resolve the referenced hostname at request time instead of pinning its
  # address when nginx starts.
  resolver [fd12::10] valid=10s ipv6=on;
  set $adsbao_service_origin ${ADSBAO_SERVICE_ORIGIN};

  location /api/ {
    proxy_pass $adsbao_service_origin;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /ws {
    proxy_pass $adsbao_service_origin;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /health {
    proxy_pass $adsbao_service_origin;
  }

  location = /runtime-env.js {
    add_header Cache-Control "no-store";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
