# Public frontend origin used by local Vite and the runtime configuration.
# Production normally injects this through its deployment configuration.
ADSBAO_SITE_URL=
VITE_SITE_URL=

# Optional local API override. The default is http://localhost:8082 and is
# usually correct when `pnpm debug:local:service` is used.
VITE_ADSBAO_LOCAL_API_ORIGIN=
ADSBAO_LOCAL_API_ORIGIN=

# Optional trusted LAN hostname or private IPv4 override for
# `pnpm debug:device`. Leave it blank to prefer en0/en1 automatically. Do not
# include a protocol or path.
ADSBAO_LOCAL_DEVICE_HOST=

# Optional browser-side upstream overrides. Keep them same-origin or point them
# only at an intentionally configured test gateway; never put service secrets
# in `VITE_*` variables.
VITE_AIRCRAFT_PHOTOS_BASE=
VITE_AIRCRAFT_POSITIONS_BASE=
VITE_AIRCRAFT_TRACE_BASE=
VITE_LOCAL_WEATHER_BASE=
VITE_METAR_PROXY_BASE=

# Browser-visible observability configuration, only when it is intentionally
# enabled for this environment. These values are runtime client configuration,
# not private-service credentials.
VITE_NEW_RELIC_ACCOUNT_ID=
VITE_NEW_RELIC_BROWSER_APP_ID=
VITE_NEW_RELIC_BROWSER_LICENSE_KEY=

# Optional build-time fallback for the Three+OSM POC during local Vite work.
# Deployed hosts should prefer the no-store /runtime-env.js bindings instead.
# Any key in the URL must be a domain-restricted public browser key.
VITE_THREE_OSM_RASTER_SOURCE_ID=
VITE_THREE_OSM_RASTER_URL_TEMPLATE=
VITE_THREE_OSM_RASTER_ATTRIBUTION=
VITE_THREE_OSM_RASTER_ATTRIBUTION_URL=

# Private-service deployment variables and credentials do not belong in this
# public example. For a local service run, follow
# ../ADSBao-Secret-Service/services/adsbao-service/README.md and put values
# only in an uncommitted .env.local.
